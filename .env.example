# ─────────────────────────────────────────────────────────────────────────────
# Z-Jobs environment.
#
# Copy to `.env` and fill in. Every key here is parsed by src/lib/env.ts with
# Zod AT IMPORT TIME and the process THROWS if anything required is missing or
# malformed. A missing CHAPA_SECRET_KEY fails the deploy instead of surfacing
# as a 500 inside a customer's checkout.
#
# Never commit .env — `.gitignore` covers `.env` and `.env.*` except this file.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development

# Absolute public origin, no trailing slash. EVERY link in every transactional
# email is built from this. The old app hardcoded http://localhost:5000 into the
# verification email, which meant no production user could ever verify.
APP_URL=http://localhost:3000

# ── Database ────────────────────────────────────────────────────────────────
# Dev matches docker-compose.yml (bound to loopback on 3307).
DATABASE_URL="mysql://zjobs:zjobs@127.0.0.1:3307/z_jobs"

# ── Sessions ────────────────────────────────────────────────────────────────
# 32+ random bytes. Generate: openssl rand -base64 48
# Used to derive the session-token pepper; rotating it logs everyone out.
SESSION_SECRET=

# ── Redis (rate limiting + cache) ───────────────────────────────────────────
# Optional in dev: when unset, rate limiting falls back to the RateLimitBucket
# table. Required in production.
REDIS_URL="redis://127.0.0.1:6380"

# ── Email (Resend) ──────────────────────────────────────────────────────────
# Optional in dev: when unset, mail is written to the console instead of sent.
RESEND_API_KEY=
MAIL_FROM="Z-Jobs <noreply@jobs.zakisu.tech>"
MAIL_REPLY_TO="support@jobs.zakisu.tech"

# ── Object storage (S3-compatible: MinIO in dev, Cloudflare R2 in prod) ─────
S3_ENDPOINT="http://127.0.0.1:9000"
S3_REGION="auto"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_BUCKET_PUBLIC="zjobs-public"
S3_BUCKET_PRIVATE="zjobs-private"
# Host serving the public bucket. Also allowlisted in next.config.ts images.
NEXT_PUBLIC_PUBLIC_ASSET_HOST=

# ── Payments (Chapa) ────────────────────────────────────────────────────────
# Optional until Phase 4; required once BILLING_ENABLED=true.
# Merchant onboarding needs business registration + TIN + bank account and
# takes time — start that application early, it gates the revenue milestone.
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=
BILLING_ENABLED=false

# ── Observability ───────────────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
LOG_LEVEL=info
